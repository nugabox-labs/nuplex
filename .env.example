# NUPLEX 환경변수 — 이 파일을 .env 로 복사해 채운다. .env 는 커밋하지 않는다.
# dev/prod 값은 동일하다. 차이는 compose 구성(핫리로드 여부)뿐이다 — AGENTS.md §2

TZ=Asia/Seoul

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=nuplex
POSTGRES_PASSWORD=
POSTGRES_DB=nuplex
# web · sync 컨테이너에서 db 서비스로 붙는 주소. 호스트에서 직접 붙을 땐 localhost:2621
DATABASE_URL=postgres://nuplex:<POSTGRES_PASSWORD>@db:5432/nuplex

# --- Plex Media Server ------------------------------------------------------
# 여기 값들은 sync 워커만 사용한다. web 컨테이너는 Plex를 호출하지 않는다.
PLEX_BASE_URL=https://plex.nugabox.com
# Plex 웹 → 아무 항목 ⋯ → Get Info → View XML → 주소창의 X-Plex-Token 값
PLEX_TOKEN=
# https://plex.nugabox.com/identity 의 machineIdentifier. 딥링크 생성에 쓰인다.
PLEX_SERVER_ID=4962aaf03eed5e9749e2ae3050c7c5d6af8fc1cd
# 이 앱을 식별하는 고정 UUID. 한 번 정하면 바꾸지 않는다.
PLEX_CLIENT_ID=

# 서비스의 외부 주소. 카카오톡 · 메신저 링크 미리보기(OG 이미지)가 절대 주소를 요구한다.
SITE_URL=https://nuplex.nugabox.com

# --- 접근 제어 (공통 비밀번호 1개) -------------------------------------------
# 평문은 어디에도 저장하지 않는다. `npm run hash-password -- '<비밀번호>'` 로 생성한다.
APP_PASSWORD_HASH=
# 세션 쿠키 서명 키. `openssl rand -hex 32`
SESSION_SECRET=

# 관리자 (알림 발송) 비밀번호 해시. 위 공개 비밀번호와 반드시 다른 값을 쓴다 —
# 공개 비밀번호는 지인에게 공유하는 것이라 그걸로 알림까지 보낼 수 있으면 안 된다.
ADMIN_PASSWORD_HASH=

# --- 푸시 (FCM) --------------------------------------------------------------
# Firebase 서비스 계정 JSON 을 base64 한 줄로. 설정 방법은 docs/FIREBASE-SETUP.md
# 비어 있으면 푸시를 보내지 않고 발송 대기만 쌓는다(웹 알림은 정상 동작).
# 앱 셸 쪽 설정값은 아래 "모바일 앱 셸" 절에 모여 있다.
FCM_SERVICE_ACCOUNT=

# --- 동기화 -----------------------------------------------------------------
# 동기화 · 화면에서 제외할 Plex 섹션 id. 쉼표로 구분한다.
# 여기 적힌 섹션은 sync 가 건너뛰고, 이미 받아둔 데이터도 지운다.
EXCLUDED_SECTION_IDS=
# 포스터 · 배경 이미지 저장 위치 (컨테이너 내부 경로. 호스트 ./data/media 에 바인드)
MEDIA_DIR=/app/data/media
# 증분 동기화 — 기본 30분마다
SYNC_INCREMENTAL_CRON=*/30 * * * *
# 전체 동기화(삭제 감지 포함) — 기본 매일 04:00 KST
SYNC_FULL_CRON=0 4 * * *

# --- 모바일 앱 셸 (nuplex-app) ----------------------------------------------
# GET /api/app/config 가 그대로 돌려주는 값들이다. 앱 업데이트 없이 셸 동작을
# 바꿀 수 있는 유일한 통로다 — docs/APP-INTEGRATION.md
#
# 이 값 미만의 앱은 강제 업데이트 화면에서 멈춘다.
# 스토어에 새 버전이 실제로 올라간 뒤에만 올릴 것.
APP_MIN_SUPPORTED_VERSION=1.0.0
APP_RECOMMENDED_VERSION=1.0.0
# 점검 중일 때 1. 앱에 점검 안내 화면이 뜬다.
APP_MAINTENANCE=0
APP_MAINTENANCE_MESSAGE=
# 0 이면 앱이 알림 권한을 아예 요청하지 않는다. FCM 자격증명을 넣기 전까지 0 을 권한다.
APP_PUSH_ENABLED=1
# plex:// 커스텀 스킴 실험 플래그. 공식 문서화된 스킴이 아니라서 기본은 꺼둔다.
APP_PLEX_CUSTOM_SCHEME=0
# 심사 통과 후 채운다. 비어 있으면 앱이 스토어 버튼을 감춘다.
APP_STORE_URL_IOS=
APP_STORE_URL_ANDROID=
